# Env key catalog (infrastructure §2). Copy to .env and fill values; .env is gitignored.
# Never commit real secrets — placeholders only here.

# PostgreSQL (remote, shared) — psycopg3 async driver (infra §3)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DB_SCHEMA=archive

# MinIO (remote, http) (infra §4)
MINIO_ENDPOINT=http://HOST:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=document-archive-refine

# Redis (local Docker) (infra §5)
REDIS_URL=redis://localhost:6379/0

# llama-server (local, native Metal) (infra §6)
LLAMA_CHAT_URL=http://localhost:8080
LLAMA_EMBED_URL=http://localhost:8081

# AI Provider selection: llama | bedrock(추후) (backend §8)
LLM_PROVIDER=llama
EMBEDDING_PROVIDER=llama
